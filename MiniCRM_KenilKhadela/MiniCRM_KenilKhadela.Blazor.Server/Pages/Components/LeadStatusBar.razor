@using MiniCRM_KenilKhadela.Blazor.Server.Editors.Lead_StatusBar
@using MiniCRM_KenilKhadela.Module.BusinessObjects
@using static MiniCRM_KenilKhadela.Module.BusinessObjects.Lead
@using DevExpress.ExpressApp
@implements IDisposable

<div class="lead-status-bar">
    <div class="status-container">
        @foreach (LeadProcessStageEnum stage in Enum.GetValues(typeof(LeadProcessStageEnum)))
        {
            <div class="status-item
                        @(IsCompleted(stage) ? "completed" : "")
                        @(SelectedStage == stage ? "selected" : "")">

                <input type="checkbox"
                       checked="@IsCompleted(stage)"
                       class="read-only-checkbox" />

                <span>@stage</span>
            </div>

            @if (stage != LeadProcessStageEnum.Closed)
            {
                <span class="arrow">→</span>
        
                <LeadStatusBar />
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public LeadStatusBarViewItem ViewItem { get; set; }

    private Lead Lead => ViewItem?.View?.CurrentObject as Lead;
    private LeadProcessStageEnum? SelectedStage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SubscribeToEvents();
        UpdateSelectedStage();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (!firstRender)
        {
            UpdateSelectedStage();
        }
    }

    private void SubscribeToEvents()
    {
        if (ViewItem?.View?.ObjectSpace != null)
        {
            ViewItem.View.ObjectSpace.ObjectChanged += ObjectSpace_ObjectChanged;
        }
    }

    private void ObjectSpace_ObjectChanged(object sender, ObjectChangedEventArgs e)
    {
        if (e.Object == Lead && e.PropertyName == nameof(Lead.LeadProcessStage))
        {
            UpdateSelectedStage();
            InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateSelectedStage()
    {
        if (Lead != null)
        {
            SelectedStage = Lead.LeadProcessStage;
        }
    }

    private bool IsCompleted(LeadProcessStageEnum stage)
    {
        if (stage == LeadProcessStageEnum.Open)
            return true;

        if (Lead == null)
            return false;

        return Lead.LeadProcessStage >= stage;
    }

    public void RefreshUI()
    {
        UpdateSelectedStage();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (ViewItem?.View?.ObjectSpace != null)
        {
            ViewItem.View.ObjectSpace.ObjectChanged -= ObjectSpace_ObjectChanged;
        }
    }
}

<style>
    .lead-status-bar {
        width: auto;
        padding: 20px 100px 20px 100px;
        background-color: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 20px;
        height: 100px;
    }

    .status-container {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: nowrap;
        gap: 50px;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        background-color: white;
        border: 2px solid #dee2e6;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

        .status-item.completed {
            background-color: #d1e7dd;
            border-color: #0f5132;
        }

        .status-item.selected {
            background-color: #cfe2ff;
            border-color: #084298;
            font-weight: 600;
        }

        .status-item input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #0d6efd;
        }

        .status-item span {
            font-weight: 500;
            color: #495057;
            user-select: none;
        }

        .status-item.selected span {
            color: #084298;
            font-weight: 600;
        }

        .status-item.completed span {
            color: #0f5132;
        }

    .arrow {
        font-size: 24px;
        color: #adb5bd;
        font-weight: bold;
    }

    .read-only-checkbox {
        pointer-events: none;
        cursor: default;
    }
</style>
